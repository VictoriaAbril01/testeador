# Copy to .env and set a unique local password. Never commit .env.
POSTGRES_USER=testlab
POSTGRES_DB=testlab
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# Generate unique values locally. Never commit the filled .env file.
TESTLAB_API_KEY=
TESTLAB_FERNET_KEY=
API_PORT=8000
TESTLAB_QUEUE_ENABLED=false
TESTLAB_EVIDENCE_RETENTION_DAYS=30
# Optional outside Docker; default is ignored artifacts/private inside the workspace.
# TESTLAB_EVIDENCE_ROOT=C:/private/testlab-evidence
# Private targets require a separate worker deployment with explicit network access.
